# Copy to .env (ignored by git) and fill in. See README.md for every variable.

# Dolibarr REST API, ending with /api/index.php
DOLIBARR_URL=https://erp.example.com/api/index.php
# API key of a dedicated Dolibarr user, with the narrowest permissions possible
DOLIBARR_API_KEY=
# Register the tools that write to Dolibarr (create, validate, raw requests)
DOLIBARR_ALLOW_WRITE=false

# stdio (local MCP clients) or http (streamable HTTP, served at /mcp)
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000
